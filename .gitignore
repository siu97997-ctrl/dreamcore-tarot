# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.env

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# 项目本地工作副本（含自有 .git，不要推到部署仓库）
/web/

# 部署用压缩包（体积大，非源码）
*.zip

# 临时文件
/tmp/
